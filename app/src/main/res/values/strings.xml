<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tên ứng dụng hiển thị trên màn hình -->
    <string name="app_name">Kênh YouTube</string>
    <!-- Trang danh sách phát (playlists) của kênh -->
    <string name="channel_url">https://www.youtube.com/@nguyencmu69/playlists</string>
    <!-- true = dùng giao diện YouTube bản máy tính (thử nếu video vẫn mờ) -->
    <bool name="desktop_mode">true</bool>
    <!-- true = ép YouTube chỉ gửi video H.264 (chặn VP9/AV1), hợp với box cũ -->
    <bool name="force_h264">false</bool>
    <!-- true = tự phát lần lượt tất cả playlist rồi lặp lại; false = chỉ duyệt kênh bình thường -->
    <bool name="auto_play_playlists">true</bool>
</resources>
